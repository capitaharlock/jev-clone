# MeshKore — runtime state (do not commit)
# Everything else under .meshkore/ (public, docs, modules, roadmap/initiatives) IS versioned.
.meshkore/.runtime/
.meshkore/credentials/
.meshkore/agents/
.meshkore/timeline/
.meshkore/log/
.meshkore/queues/
.meshkore/uploads/
.meshkore/snapshots/
.meshkore/state.json
.meshkore/roadmap/state.json
.meshkore/roadmap/state.js
.meshkore/scripts/
artifacts/logs/
artifacts/data-qwen/

# Model weights (#T-torch-stack): bytes stay out of git, manifests stay in.
artifacts/weights/*
!artifacts/weights/*/
artifacts/weights/*/*
!artifacts/weights/*/manifest.json

# Listwise decision training (#T-train-real): the live step curve and the
# checkpoint bytes stay out of git; gate.json, the run manifest and the
# checkpoint manifest.json (which carry model_version + tokenizer_hash)
# stay in.
artifacts/runs/*/metrics.jsonl
artifacts/checkpoints/*/*/*/model.safetensors
artifacts/checkpoints/*/*/*/tokenizer.json

# Generated / heavy — never in git (#T-train-real)
__pycache__/
*.pyc
artifacts/data-raw/
artifacts/data-prefetch/*.jsonl
artifacts/data-prefetch/quarantine/
