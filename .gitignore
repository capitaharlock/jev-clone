# MeshKore — runtime state (do not commit)
# Everything else under .meshkore/ (public, docs, modules, roadmap/initiatives) IS versioned.
.meshkore/.runtime/
.meshkore/credentials/
.meshkore/agents/
.meshkore/timeline/
.meshkore/log/
.meshkore/queues/
.meshkore/uploads/
.meshkore/snapshots/
.meshkore/state.json
.meshkore/roadmap/state.json
.meshkore/roadmap/state.js
.meshkore/scripts/

# Build output (#T-repo-clean): `cargo build` reproduces every byte of this
# from Cargo.toml + Cargo.lock. 9 145 files / 788 MiB of it were versioned.
target/

# Heavy artifacts (#T-repo-clean): weights, per-run models and prefetched
# datasets never enter git — not even their manifests. What makes them
# reproducible is `.meshkore/docs/source-register.md`: repo, revision, sha256
# and where the bytes live. Re-fetch with `python -m model.weights fetch`
# and `make prefetch`.
artifacts/runs/
artifacts/weights/
artifacts/data-prefetch/
artifacts/data-raw/
artifacts/data-qwen/
artifacts/logs/
*.pkl

# Checkpoints (#T-train-real): the bytes stay out, the manifest.json stays in —
# it carries model_version, tokenizer_hash and weights_sha256, which is what
# lets a gate name the checkpoint it scored.
artifacts/checkpoints/*/*/*/model.safetensors
artifacts/checkpoints/*/*/*/tokenizer.json

# Sealed splits (#T-split-domain): the id lists are megabytes of row ids;
# git carries the manifest (seed + sha256 of every ids file), which is what
# makes a split verifiable, not the bytes.
artifacts/splits/*/*.ids

# Programmatic gold shards (#T-prog-gold): 115 MB of rows rebuilt from the
# cached graph in ~50 s. git carries gate.json, whose per-shard sha256 is
# what makes the corpus verifiable — the bytes are not.
artifacts/prog_gold/*/*.jsonl

# Supply cache (#T-mix-1m): a derived index of the prefetched corpus, keyed
# on every shard's (path, size, mtime). It exists so a guardrail check does
# not re-read a gigabyte of civil-comments; it rebuilds itself in seconds and
# says nothing git does not already have in the mix manifests.
artifacts/mix/supply-cache.json

# Corpus assembly (#T-mix-1m): the manifest of `decision-mix-clean-1m` stays
# in git — seed, per-shard sha256, quotas and members_sha256 are what make
# the corpus rebuildable. The curve's run log is per-machine noise.
artifacts/mix-1m/curve.jsonl

# Python
.venv-train/
__pycache__/
*.pyc
.ruff_cache/

# macOS
.DS_Store
